          "raw": "{\n  \"rol\": \"Presbitero\",\n  \"activo\": true\n}"
        },
        "url": {
          "raw": "http://localhost:3000/api/usuarios/e4f5a6b7-8901-2345-6789-abcdef012345",
          "protocol": "http",
          "host": ["localhost"],
